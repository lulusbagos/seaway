@model SeaWay.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - SeaWay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SeaWay.styles.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-scanline" aria-hidden="true"></div>
            <div class="auth-orb auth-orb-a"></div>
            <div class="auth-orb auth-orb-b"></div>
            <div class="auth-orb auth-orb-c"></div>

            <div class="auth-hero-brand">
                <div class="auth-hero-brand-mark">
                    <span class="brand-sweep" aria-hidden="true"></span>
                    <span class="brand-pulse"></span>
                </div>
                <div class="auth-hero-brand-copy">
                    <h1 class="auth-title" aria-label="SEA WAY">
                        <span class="auth-title-sea">SEA</span>
                        <span class="auth-title-way">WAY</span>
                    </h1>
                    <div class="auth-subline">
                        <span class="auth-subline-dot"></span>
                        <span class="auth-subline-text">Tha se vro</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-panel">
            <div class="auth-panel-metrics" aria-hidden="true">
                <span>UTC+08</span>
                <span>DB Sync</span>
                <span>Role Bound</span>
            </div>
            <div class="auth-panel-grid" aria-hidden="true"></div>
            <div class="auth-loading-overlay" aria-hidden="true">
                <div class="auth-loading-core">
                    <div class="auth-loading-ring"></div>
                    <div class="auth-loading-ring auth-loading-ring-alt"></div>
                    <div class="auth-loading-mark"></div>
                </div>
                <div class="auth-loading-copy">Authenticating SeaWay</div>
            </div>
            <div class="auth-card">
                <div class="auth-card-header">
                    <div class="panel-eyebrow">Direct DB Access</div>
                    <h2>SeaWay Control Portal</h2>
                </div>

                <div class="auth-card-status-row" aria-hidden="true">
                    <span class="auth-status-pill active"><span class="auth-status-dot"></span> DB online</span>
                    <span class="auth-status-pill"><span class="auth-status-bar"></span> Secure session</span>
                </div>

                <div class="auth-card-glow" aria-hidden="true"></div>

                <form asp-action="Login" method="post" class="form-stack auth-login-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger auth-summary"></div>

                    <div>
                        <label asp-for="UserName"></label>
                        <input asp-for="UserName" class="field-control" placeholder="operator" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="field-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ingat perangkat ini</label>
                    </div>

                    <button type="submit" class="submit-button">
                        <span class="submit-button-label">Akses Control Room</span>
                        <span class="submit-button-spinner" aria-hidden="true"></span>
                    </button>
                </form>

                <div class="auth-copyright">
                    Developed and Maintained by System Integration Department PT Indexim Coalindo
                </div>
            </div>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
