@{
    var pageTitle = ViewData["Title"] as string ?? "Dashboard";
    var pageSubtitle = ViewData["Subtitle"] as string ?? "Monitoring operasional armada secara realtime.";
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var userName = User.Identity?.Name ?? "Fleet Supervisor";
    var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Viewer";
    var bootTransition = string.Equals(Context.Request.Query["boot"], "1", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - SeaWay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SeaWay.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="page-transition-overlay @(bootTransition ? "is-visible" : string.Empty)" id="pageTransitionOverlay" aria-hidden="true">
        <div class="page-transition-core">
            <div class="page-transition-ring"></div>
            <div class="page-transition-ring page-transition-ring-alt"></div>
            <div class="page-transition-mark">
                <span></span>
            </div>
        </div>
        <div class="page-transition-copy">Booting SeaWay Control Room</div>
    </div>

    <div class="layout-shell" id="layoutShell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand-panel pb-2">
                <div class="w-100">
                    <div class="d-flex align-items-center mb-3">
                        <div class="brand-logo me-3" style="width: 42px; height: 42px; background: linear-gradient(135deg, #00f0ff 0%, #0284c7 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0, 240, 255, 0.3);">
                            <i class="bi bi-tsunami" style="color: #fff; font-size: 1.6rem; text-shadow: 0 2px 4px rgba(0,0,0,0.3);"></i>
                        </div>
                        <div>
                            <div class="brand-title" style="font-size: 1.5rem; font-weight: 900; letter-spacing: 1.5px; color: #ffffff; text-transform: uppercase; line-height: 1.1; margin-bottom: 2px;">SEAWAY</div>
                            <div style="font-size: 0.65rem; color: #94a3b8; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Command System</div>
                        </div>
                    </div>
                    <div class="brand-badge" style="width: 100%; display: flex; align-items: center; justify-content: center; background: rgba(0, 240, 255, 0.08); border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 8px;">
                        <span class="brand-pulse"></span>
                        <span style="font-weight: 700; letter-spacing: 1px; color: #00f0ff;">LIVE TRACKING</span>
                    </div>
                </div>
                <button class="sidebar-toggle d-lg-none" type="button" data-sidebar-close>
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="sidebar-section mt-2">
                <nav class="sidebar-nav">
                    <a class="sidebar-link @(controllerName == "Dashboard" ? "active" : null)" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-broadcast-pin"></i>
                        <span>Live Monitor</span>
                    </a>
                    <a class="sidebar-link @(controllerName == "Replay" ? "active" : null)" asp-controller="Replay" asp-action="Index">
                        <i class="bi bi-play-circle"></i>
                        <span>Histori & Replay</span>
                    </a>
                    <a class="sidebar-link @(controllerName == "Fleet" ? "active" : null)" asp-controller="Fleet" asp-action="Index">
                        <i class="bi bi-life-preserver"></i>
                        <span>Fleet Board</span>
                    </a>
                    <a class="sidebar-link @(controllerName == "Roles" ? "active" : null)" asp-controller="Roles" asp-action="Index">
                        <i class="bi bi-shield-lock"></i>
                        <span>Role Access</span>
                    </a>
                    <a class="sidebar-link @(controllerName == "Units" && ViewContext.RouteData.Values["action"]?.ToString() == "QuickAdd" ? "active" : null)" asp-controller="Units" asp-action="QuickAdd">
                        <i class="bi bi-plus-square"></i>
                        <span>Add Unit</span>
                    </a>
                </nav>
            </div>

        </aside>

        <div class="sidebar-backdrop" data-sidebar-close></div>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-heading">
                    <button class="mobile-menu-button d-lg-none" type="button" data-sidebar-open>
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <h1 class="topbar-title m-0">@pageTitle</h1>
                    </div>
                </div>

                <div class="topbar-actions">
                    <div class="topbar-search">
                        <i class="bi bi-search"></i>
                        <input type="text" value="Cari kapal, IMO, geofence..." readonly />
                    </div>
                    
                    <div class="dropdown" id="smartAlertDropdown">
                        <button type="button" class="status-pill muted border-0 position-relative" data-bs-toggle="dropdown" aria-expanded="false" title="Pusat Peringatan (Smart Alerts)">
                            <i class="bi bi-bell-fill" style="font-size: 1.05rem;"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="smartAlertBadge" style="display: none; font-size: 0.6rem; transform: translate(-30%, 30%) !important;">
                                0
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" style="min-width: 320px; max-height: 400px; overflow-y: auto;" id="smartAlertList">
                            <li class="dropdown-header border-bottom border-secondary pb-2 mb-2">Smart Alerts</li>
                            <li><a class="dropdown-item text-muted text-center small" href="#" id="smartAlertEmpty">Tidak ada peringatan armada</a></li>
                        </ul>
                    </div>

                    <div class="status-pill live">
                        <span class="status-dot"></span>
                        Armada Aktif
                    </div>
                    <div class="status-pill muted">
                        Role: @roleName
                    </div>
                    <div class="operator-chip">
                        <span class="operator-avatar">@userName[..1].ToUpperInvariant()</span>
                        @userName
                    </div>
                    <button type="button" class="status-pill muted border-0" id="btnToggleAppFullscreen" title="Layar Penuh Workspace">
                        <i class="bi bi-arrows-fullscreen"></i> Fullscreen
                    </button>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="status-pill muted border-0">
                            <i class="bi bi-box-arrow-right"></i>
                            Logout
                        </button>
                    </form>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["LoginPreview"] is string loginPreview)
                {
                    <div class="card-panel mb-4">
                        <div class="badge-soft live">@loginPreview</div>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; @DateTime.UtcNow.Year PT Pelayaran Ganesha Lautjaya. All rights reserved.</span>
                <span>Pusat Pemantauan Operasional Armada &amp; Navigasi Maritim</span>
            </footer>
        </div>
    </div>

    <!-- Toast Container for Smart Alerts -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;" id="smartAlertToastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
